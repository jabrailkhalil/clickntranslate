# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.so

# Distribution / packaging
build/
dist/
releases/
*.egg-info/

# Build scripts and specs
build.py
*.spec
!ClicknTranslate.spec

# Virtual environments
venv/
.venv/
.venv*/
.env

# IDE / editor settings
.idea/
.vscode/
.claude/

# Temporary files
temp/

# Downloaded OCR engine
ocr/tesseract/

# Downloaded local translator engines/models
translators/
*.gguf

# Logs and debug files
*.log
launch_log.txt

# Debug images
debug_*.png

# Misc junk files
git
task.txt
%VBS%

# PyInstaller artefacts
*.pyz
*.pkg
*.toc

# Windows binaries
*.exe
*.dll

# Batch files (for testing)
*.bat

# JARs and data models
*.jar
*.traineddata

# User data (runtime generated)
data/config.json
data/copy_history.json
data/translation_history.json
data/settings.json
data/cache/
data/logs/
data/**/*.png
data/**/*.log

# Shell scripts
*.cmd
*.ps1
*.sh

!build_release.bat
!installer/windows/CreateShortcut.bat
# Every release build script must be tracked.  Whitelisting them one by one is
# how tools/build_apply_updater.ps1 came to be missing from the repo even though
# tools/stage_release.ps1 requires it, which broke release staging outright.
!tools/*.ps1
